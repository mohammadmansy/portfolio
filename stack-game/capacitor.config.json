{
  "appId": "com.mohammadmansy.stack",
  "appName": "Stack",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#0B0E13",
      "androidSplashResourceName": "splash",
      "launchAutoHide": true
    },
    "Haptics": {},
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0B0E13"
    }
  }
}
